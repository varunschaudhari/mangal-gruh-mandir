PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/mgm_stock

JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000

# Default super admin (used by seed script)
SEED_ADMIN_EMAIL=admin@mandir.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=Super Admin

# WhatsApp Cloud API (Meta)
# Get from: https://developers.facebook.com → Your App → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=your_phone_number_id_here
WA_ACCESS_TOKEN=your_permanent_access_token
WA_TEMPLATE_NAME=stock_alert

# MSG91 SMS Alerts
# Get from: https://msg91.com → API → Auth Key
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# Donation Module — WhatsApp thank-you template
# Template body: "Dear {{1}}, thank you for your donation of {{2}} to {{3}} on {{4}}. Receipt: {{5}}. 🙏"
WA_DONATION_TEMPLATE_NAME=donation_thankyou

# Asset Module — WhatsApp & SMS reminder templates
# Create separate approved templates for asset borrow reminders
WA_ASSET_TEMPLATE_NAME=asset_reminder
MSG91_ASSET_TEMPLATE_ID=your_msg91_asset_template_id
