PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/mgm_stock

JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d   # browser / desktop sign-in lifetime (fixed)
# SESSION_DAYS_APP=90       # mobile app sign-in lifetime (rolling — extended every time the app is used)

CLIENT_URL=http://localhost:3000
# Public web address used in receipt links sent to devotees (defaults to the first CLIENT_URL)
# PUBLIC_APP_URL=https://mandir.aumora.io

# Default super admin (used by seed script)
SEED_ADMIN_EMAIL=admin@mandir.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=Super Admin

# WhatsApp Cloud API (Meta) — set up in the app: Settings → WhatsApp (switch, Phone Number ID,
# token, and the approved template for each message; the booking receipt's is in Bookings → Setup).
# These two are only a fallback for the number ID and token; Settings wins when filled in.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# WA_GRAPH_VERSION=v25.0

# Push notifications to the mobile apps (Firebase Cloud Messaging) — optional, see MOBILE.md.
# Service-account JSON from Firebase console → Project settings → Service accounts → Generate key,
# pasted as one line or base64-encoded:  base64 -w0 service-account.json
# FIREBASE_SERVICE_ACCOUNT=

# MSG91 SMS Alerts
# Get from: https://msg91.com → API → Auth Key
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# Mahaprasad — coupon numbers to the devotee's mobile by SMS after each issue (optional; WhatsApp is
# set up in Settings → WhatsApp). MSG91: a Flow with a DLT-approved template using ##date##,
# ##coupons##, ##persons##.
MSG91_MAHAPRASAD_TEMPLATE_ID=

# Asset Module — SMS reminder template (the WhatsApp one is named in Settings → WhatsApp)
MSG91_ASSET_TEMPLATE_ID=your_msg91_asset_template_id
