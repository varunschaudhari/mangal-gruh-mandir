# nginx template: the nginx container fills in ${DOMAIN} (from the root .env) when it starts and
# writes the result to /etc/nginx/conf.d/app.conf. Edit this file, never a copy on the server.
# Only variables set in the container's environment are replaced; nginx's own $host, $uri etc. stay.

# The app containers are looked up through Docker's DNS on every request (cached 10 s) rather
# than once when nginx starts: a rebuild gives them new addresses, and nginx would otherwise
# keep calling the old ones — 502 Bad Gateway until nginx was restarted.
resolver 127.0.0.11 valid=10s ipv6=off;

# Redirect HTTP to HTTPS
server {
    listen 80;
    server_name _;
    set $server_app http://server:5000;
    # FkWeb machines name their requests in headers with underscores (request_code, dev_id…),
    # which nginx otherwise drops
    underscores_in_headers on;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Biometric attendance machine (ADMS protocol). Many machines can't do HTTPS, so this
    # path is served over plain HTTP too. The server only accepts machines approved in
    # Settings → Attendance.
    location /iclock/ {
        proxy_pass $server_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 2m;
    }

    # Biometric machines on the FkWeb protocol (Team Office Z900…), Web Server URL
    # http://<domain>/fkweb. Same approval rules as /iclock.
    location /fkweb {
        proxy_pass $server_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 2m;
    }

    location / {
        # An FkWeb machine given only the address (no /fkweb) posts to / — send it on
        if ($http_request_code) {
            rewrite ^ /fkweb last;
        }
        return 301 https://$host$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl;
    server_name ${DOMAIN};
    set $client_app http://client:80;
    set $server_app http://server:5000;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    underscores_in_headers on;   # FkWeb machines (see the port 80 server)

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection "1; mode=block";

    # Static user manual (served directly from the repo's docs/manual folder)
    location = /manual {
        return 301 /manual/;
    }
    location /manual/ {
        alias /usr/share/nginx/html/manual/;
        index index.html;
        try_files $uri $uri/ =404;
    }

    # React app (served by nginx inside client container)
    location / {
        proxy_pass $client_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Biometric attendance machine (same as on port 80, for machines that use HTTPS)
    location /iclock/ {
        proxy_pass $server_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 2m;
    }

    # FkWeb biometric machines (same as on port 80, for machines that use HTTPS)
    location /fkweb {
        proxy_pass $server_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 2m;
    }

    # API proxy to Node.js server
    location /api/ {
        proxy_pass $server_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
    }
}
