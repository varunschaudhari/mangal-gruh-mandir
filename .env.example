# Domain (used by init-letsencrypt.sh for nginx + SSL cert)
DOMAIN=mandir.aumora.io
CERTBOT_EMAIL=you@example.com

# Nightly database backups (backup-db.sh) — all optional, see DEPLOY.md §10
# BACKUP_DIR=/var/backups/mgm
# KEEP_DAILY=14
# KEEP_WEEKLY=8
# RCLONE_REMOTE=gdrive:mgm-backups          # off-site copy (needs rclone configured)
# HEALTHCHECK_URL=https://hc-ping.com/<uuid> # email alert if a night's backup fails or doesn't run

# NOTE: MongoDB is now hosted on MongoDB Atlas (managed cloud).
# The connection string lives in server/.env as MONGO_URI — see server/.env.example.
# No local MongoDB container or credentials are needed here anymore.
